# =============================================================================
#  cmake/Verible.cmake —— vendored Verible（Bazel -> CMake 移植）接入
# =============================================================================
#  负责人：成员 verible-build（任务 0-B）。本文件整份重写自 cmake-scaffold 的占位骨架，
#  但保留两个对外契约：
#    1. option(FPGA_LSP_VERIBLE_ENABLED ... OFF)   —— 名字与默认值不变
#    2. target fpga_lsp::verible                   —— 下游（cst_dump）用它链接
#
#  另有两个硬契约（阶段 0 门禁依赖，不要改名）：
#    * verible_parser_libs     —— 聚合 parser + CST + 传递依赖的 INTERFACE target
#    * verible_common_opts     —— 所有 verible_* target 的统一编译选项
#
#  目录约定：
#    thirdparty/verible/                       <- include 根（源码写 "verible/common/..."）
#    thirdparty/verible/verible/<pkg>/CMakeLists.txt
#       由 tools/gen_verible_cmake.py 从 Bazel BUILD 转译而来（GENERATED，勿手改）
#    cmake/scripts/verible-generators.cmake    <- flex/bison 代码生成（任务 0-D 提供）
# =============================================================================

include_guard(GLOBAL)

option(FPGA_LSP_VERIBLE_ENABLED
       "接入 vendored Verible（Bazel -> CMake 移植，阶段 0-B/0-D）"
       OFF)

# 是否编译 Verible 自带的 225 个 cc_test（默认 OFF，阶段 0 不编）
option(FPGA_LSP_VERIBLE_BUILD_TESTS
       "同时编译 Verible 自带的 cc_test（需要 fpga-lsp-cpp 的 gtest）"
       OFF)

# 本文件所在目录 = 真正的工程根（不依赖 CMAKE_SOURCE_DIR，便于独立验证台复用）
set(_VERIBLE_INCLUDE_DIR "${CMAKE_CURRENT_LIST_DIR}")
get_filename_component(FPGA_LSP_ROOT "${_VERIBLE_INCLUDE_DIR}" DIRECTORY)
set(FPGA_LSP_VERIBLE_DIR "${FPGA_LSP_ROOT}/thirdparty/verible"
    CACHE PATH "vendored Verible 源码根目录（也是 #include 的根）")

# -----------------------------------------------------------------------------
# verible_common_opts：统一编译选项
# -----------------------------------------------------------------------------
#  - /W0        第三方代码，不要警告噪音
#  - /utf-8     源码/执行字符集
#  - /bigobj    必需：verilog-final.tab.cc（305KB verilog.y 生成）否则 C1128
#  - /permissive-  两阶段查找（顶层全局已有；这里显式声明，子库不依赖上层顺序）
#  - /Zc:__cplusplus __cplusplus 反映真实标准（abseil 依赖）
#  C++ 标准统一 C++23（不是 Verible 声明的 C++20），与 abseil 同档位避免 ODR。
#
#  注：顶层 CMakeLists.txt 已全局加 /bigobj /permissive-，这里重复加是无害的；
#  但显式写出可以保证单独 configure 本文件（例如子工程）时也成立。
if(NOT TARGET verible_common_opts)
    add_library(verible_common_opts INTERFACE)
    target_compile_features(verible_common_opts INTERFACE cxx_std_23)
    target_compile_options(verible_common_opts INTERFACE
        /W0
        /utf-8
        /permissive-
        /bigobj
        /Zc:__cplusplus
        /Zc:preprocessor
    )
    # include 根：源码里统一写 #include "verible/common/text/token-info.h"
    target_include_directories(verible_common_opts INTERFACE
        "${FPGA_LSP_VERIBLE_DIR}"
    )
endif()

# -----------------------------------------------------------------------------
# 构建期生成物目录
# -----------------------------------------------------------------------------
# 有一些生成头是按 "verible/..." 前缀被 include 的（例如
# "verible/common/util/generated-verible-build-version.h"），
# 也有一些是按裸文件名 include 的（例如 "verilog_nonterminals_foreach-gen.inc"，
# 由 verilog-nonterminals.h 所在目录以 "" 形式引入）。两种都要能解析，所以把
#   <gen>
#   <gen>/verible/common/util   （转发头）
#   <gen>/verible/verilog/parser（bison 生成的 verilog-token-enum.h 等）
# 都做成「目录级」include，这样无论 configure 顺序如何都生效。
set(_verible_gen_include_dir "${CMAKE_BINARY_DIR}/verible/gen")
set(_verible_gen_util_dir "${_verible_gen_include_dir}/verible/common/util")
set(_verible_gen_parser_dir "${_verible_gen_include_dir}/verible/verilog/parser")
set(_verible_gen_cst_dir "${_verible_gen_include_dir}/verible/verilog/CST")
file(MAKE_DIRECTORY "${_verible_gen_include_dir}"
                    "${_verible_gen_util_dir}"
                    "${_verible_gen_parser_dir}"
                    "${_verible_gen_cst_dir}")

# -----------------------------------------------------------------------------
# 空壳 STATIC 库的占位源文件
# -----------------------------------------------------------------------------
# 有些 cc_library 的 srcs 全部是构建期生成的（verilog-y-cc 的 verilog-final.tab.cc、
# verilog-lexer 的 verilog.yy.cc）。这类 target 必须建成 STATIC 库（否则没有 .lib，
# 链接时 LNK2001 找不到 verilog::verilog_parse），但 configure 期还没有源文件可写进
# add_library()。解决办法：给一个空占位源文件，生成物就绪后再 target_sources 补挂。
set(VERIBLE_PLACEHOLDER_SRC
    "${_verible_gen_include_dir}/verible_placeholder.cpp"
    CACHE INTERNAL "供「源文件全是生成物」的静态库使用的空占位源文件")
if(NOT EXISTS "${VERIBLE_PLACEHOLDER_SRC}")
    file(WRITE "${VERIBLE_PLACEHOLDER_SRC}"
"// GENERATED by cmake/Verible.cmake —— 空占位源文件。
// 用途：某些 Verible cc_library 的源文件全部由 flex/bison 在构建期生成，
// configure 期还没有可用的源文件；为了得到一个真正的 STATIC 库（有 .lib），
// 先放这个空翻译单元，生成物就绪后由 target_sources() 追加。
namespace verible_placeholder_tu {}
")
endif()
# 让所有包目录都能引用 ${VERIBLE_PLACEHOLDER_SRC}（cache INTERNAL 变量全局可见，
# 这里同时把它设为普通变量，保证生成的 CMakeLists.txt 里 ${VAR} 能展开）
set(VERIBLE_PLACEHOLDER_SRC "${VERIBLE_PLACEHOLDER_SRC}")
include_directories(
    "${_verible_gen_include_dir}"
    "${_verible_gen_util_dir}"
    "${_verible_gen_parser_dir}"
    "${_verible_gen_cst_dir}"
)

# -----------------------------------------------------------------------------
# verible_flex_lexer_runtime：BUILD 里 //bazel:flex 的 CMake 等价物
# -----------------------------------------------------------------------------
# flex 生成的 *.yy.cc 需要 <FlexLexer.h>。任务 0-D 会把 WIN_FLEX 的安装目录
# （含 FlexLexer.h）通过变量 VERIBLE_FLEX_LEXER_INCLUDE_DIR 传进来；这里先建
# 一个空的 INTERFACE target，由 0-D 的脚本 target_include_directories 填充。
if(NOT TARGET verible_flex_lexer_runtime)
    add_library(verible_flex_lexer_runtime INTERFACE)
    target_link_libraries(verible_flex_lexer_runtime INTERFACE verible_common_opts)
endif()
# 0-D 若已提供 WIN_FLEX / VERIBLE_FLEX_LEXER_INCLUDE_DIR，这里直接补上；
# 无论哪种情况都用目录级 include，保证在本文件之后创建的目标也能看到。
#
# 自动探测：flex 生成的 *.yy.cc 会 #include <FlexLexer.h>，它随 winflexbison 分发，
# 不在任何标准 include 路径里。不自动探测的话每个用户都得手动 -D，烦且容易踩坑。
# 探测顺序：显式变量 -> WIN_FLEX 所在目录 -> winflexbison 常见安装位置 -> PATH。
if(NOT DEFINED VERIBLE_FLEX_LEXER_INCLUDE_DIR OR NOT VERIBLE_FLEX_LEXER_INCLUDE_DIR)
    set(_verible_flex_hints "")
    if(DEFINED WIN_FLEX AND WIN_FLEX)
        get_filename_component(_d "${WIN_FLEX}" DIRECTORY)
        list(APPEND _verible_flex_hints "${_d}")
    endif()
    if(DEFINED WINFLEXBISON_DIR AND WINFLEXBISON_DIR)
        list(APPEND _verible_flex_hints "${WINFLEXBISON_DIR}")
    endif()
    # scoop 的 current 软链 + 版本目录
    if(DEFINED ENV{USERPROFILE})
        list(APPEND _verible_flex_hints
            "$ENV{USERPROFILE}/scoop/apps/winflexbison/current"
            "$ENV{USERPROFILE}/scoop/shims")
    endif()
    # PATH 里的 win_flex.exe
    find_program(_verible_win_flex NAMES win_flex win_flex.exe flex)
    if(_verible_win_flex)
        get_filename_component(_d "${_verible_win_flex}" DIRECTORY)
        list(APPEND _verible_flex_hints "${_d}")
    endif()
    find_path(VERIBLE_FLEX_LEXER_INCLUDE_DIR
        NAMES FlexLexer.h
        HINTS ${_verible_flex_hints}
        DOC "包含 FlexLexer.h 的目录（winflexbison 安装目录）")
    if(VERIBLE_FLEX_LEXER_INCLUDE_DIR)
        message(STATUS "Verible: FlexLexer.h 探测到 ${VERIBLE_FLEX_LEXER_INCLUDE_DIR}")
    else()
        message(WARNING
            "Verible: 没找到 FlexLexer.h。flex 生成的 *.yy.cc 会编译失败（C1083）。\n"
            "  请安装 winflexbison，或手动指定 -DVERIBLE_FLEX_LEXER_INCLUDE_DIR=<含 FlexLexer.h 的目录>")
    endif()
endif()
if(VERIBLE_FLEX_LEXER_INCLUDE_DIR AND EXISTS "${VERIBLE_FLEX_LEXER_INCLUDE_DIR}/FlexLexer.h")
    include_directories("${VERIBLE_FLEX_LEXER_INCLUDE_DIR}")
    if(TARGET verible_flex_lexer_runtime)
        target_include_directories(verible_flex_lexer_runtime INTERFACE
            "${VERIBLE_FLEX_LEXER_INCLUDE_DIR}")
    endif()
endif()

# -----------------------------------------------------------------------------
# fpga_lsp::verible —— 对外 facade（保留契约，即使 Verible 未启用也存在）
# -----------------------------------------------------------------------------
if(NOT TARGET fpga_lsp_verible)
    add_library(fpga_lsp_verible INTERFACE)
endif()
if(NOT TARGET fpga_lsp::verible)
    add_library(fpga_lsp::verible ALIAS fpga_lsp_verible)
endif()

# -----------------------------------------------------------------------------
# 未启用：只保留空的 facade，下游可以安全 link 但不会得到任何符号
# -----------------------------------------------------------------------------
if(NOT FPGA_LSP_VERIBLE_ENABLED)
    message(STATUS "Verible: 未启用（FPGA_LSP_VERIBLE_ENABLED=OFF）")
    return()
endif()

if(NOT MSVC)
    message(FATAL_ERROR "Verible 移植只支持 MSVC（当前 ${CMAKE_CXX_COMPILER_ID}）")
endif()

if(NOT EXISTS "${FPGA_LSP_VERIBLE_DIR}/verible/common/text/CMakeLists.txt")
    message(FATAL_ERROR
        "找不到 Verible 的 CMakeLists.txt：${FPGA_LSP_VERIBLE_DIR}/verible/common/text/CMakeLists.txt\n"
        "请先运行：python tools/gen_verible_cmake.py")
endif()

# =============================================================================
# 纳入构建的 Verible 包集合
#   阶段 0（task-3）：解析链路 common/{text,util,strings,lexer,parser} + verilog/{parser,CST}
#   阶段 1（task-12）：+ lint 规则（checkers 61 库）、formatter、LSP
# 顺序：被依赖者靠前（CMake 对 STATIC 的 link 顺序敏感，虽然循环依赖用
# target_link_libraries 双向声明兜底，但保持拓扑序仍然更清晰）。
# =============================================================================
set(_VERIBLE_PACKAGES
    external_libs                       # editscript：纯头文件
    verible/common/util
    verible/common/strings
    verible/common/text
    verible/common/lexer
    verible/common/parser
    verible/common/analysis/matcher
    verible/common/analysis
    verible/verilog/parser
    verible/verilog/CST
    verible/verilog/preprocessor
    verible/verilog/analysis
    # --- 阶段 1 ---
    verible/common/formatting
    verible/verilog/formatting
    verible/common/lsp                  # 含 jcxxgen 两阶段自举（见下方专门处理）
    verible/verilog/analysis/checkers   # 61 个规则库，全部 alwayslink
)

# 兼容旧名（外部脚本/文档里可能还引用 _VERIBLE_PHASE0_PACKAGES）
set(_VERIBLE_PHASE0_PACKAGES ${_VERIBLE_PACKAGES})

foreach(_pkg IN LISTS _VERIBLE_PACKAGES)
    if(EXISTS "${FPGA_LSP_VERIBLE_DIR}/${_pkg}/CMakeLists.txt")
        # 二进制目录与源码目录分离，保持源码树干净
        add_subdirectory("${FPGA_LSP_VERIBLE_DIR}/${_pkg}"
                         "${CMAKE_BINARY_DIR}/verible/${_pkg}")
        # 是否让 Verible 也参与 LTO（/GL）。
        #
        # 历史：B3 曾把「链接期 35 个 Verible 符号未解析」归因为「flex/bison 生成 TU
        # 在 /GL 下会被 LTCG 丢弃」，于是这里无条件强制 OFF。该归因**已被推翻**：
        # 真正原因是「全新 configure 时生成 TU 还没产出，verible_mount_generated_sources()
        # 挂接被跳过」，库建出来缺 lexer/parser 源 —— 与 /GL 无关，不加 LTO 的干净
        # 构建同样失败（见 doc/audit/2026-11-19/static/LTCG.md 的 E5 对照）。
        #
        # 因此这里改为可配置：默认仍 OFF（保持现有构建行为与构建耗时不变），
        # 设 -DFPGA_LSP_VERIBLE_ALLOW_LTO=ON 可让 Verible 真正进入 LTO 图。
        if(CMAKE_INTERPROCEDURAL_OPTIMIZATION AND NOT FPGA_LSP_VERIBLE_ALLOW_LTO)
            get_property(_verible_targets DIRECTORY "${FPGA_LSP_VERIBLE_DIR}/${_pkg}"
                         PROPERTY BUILDSYSTEM_TARGETS)
            foreach(_verible_target IN LISTS _verible_targets)
                set_target_properties(${_verible_target} PROPERTIES
                                      INTERPROCEDURAL_OPTIMIZATION OFF)
            endforeach()
        endif()
    else()
        message(WARNING "Verible 包缺少 CMakeLists.txt，已跳过：${_pkg}")
    endif()
endforeach()

# =============================================================================
# 构建期生成文件的挂接
# =============================================================================
# 生成的 CMakeLists.txt 会把「configure 时还不存在、构建时才生成」的文件记在
# target 属性里（Bazel 的 genrule/genlex/genyacc 产出）：
#     verible_generated_sources  -> 需要参与编译（例如 verilog-final.tab.cc）
#     verible_generated_headers  -> 只作头文件（例如 verilog-token-enum.h）
# 这里把它们补挂到对应 target 上；真正的生成命令由任务 0-D 的
# cmake/scripts/verible-generators.cmake 提供（见文件末尾的 include 点）。
#
# 若生成规则还没就绪（0-D 未交付），这些文件就挂不上——此时 parser 相关 target
# 会编译失败，这是预期的，不影响其余库。
# =============================================================================
set(_verible_gen_include_dir "${CMAKE_BINARY_DIR}/verible/gen")
file(MAKE_DIRECTORY "${_verible_gen_include_dir}")

set(_verible_all_targets "")
foreach(_dir IN LISTS _VERIBLE_PHASE0_PACKAGES)
    get_property(_tgt_here DIRECTORY "${FPGA_LSP_VERIBLE_DIR}/${_dir}"
                 PROPERTY BUILDSYSTEM_TARGETS)
    list(APPEND _verible_all_targets ${_tgt_here})
endforeach()
list(REMOVE_DUPLICATES _verible_all_targets)

# 生成物可能在的抽屉目录（按包路径镜像），逐个搜索。这样无论生成规则（0-D）
# 把产物放在哪个子目录，只要文件名对得上就能挂到 target 上。
set(_VERIBLE_GEN_SEARCH_DIRS
    "${_verible_gen_include_dir}"
    "${_verible_gen_include_dir}/verible/common/util"
    "${_verible_gen_include_dir}/verible/common/analysis"
    "${_verible_gen_include_dir}/verible/verilog/parser"
    "${_verible_gen_include_dir}/verible/verilog/CST"
)

foreach(_t IN LISTS _verible_all_targets)
    if(NOT TARGET ${_t})
        continue()
    endif()
    # 构建期生成物所在目录：verible/common/util/generated-verible-build-version.h
    # 这类「以 verible/ 开头的生成头」需要 <gen> 根，普通生成物需要 <gen> 本身。
    get_target_property(_ttype ${_t} TYPE)
    if(_ttype STREQUAL "INTERFACE_LIBRARY")
        target_include_directories(${_t} INTERFACE "${_verible_gen_include_dir}")
    else()
        target_include_directories(${_t} PRIVATE "${_verible_gen_include_dir}")
    endif()
endforeach()

# -----------------------------------------------------------------------------
# 把「构建期生成物」挂到 target 上（做成函数，延迟到生成器编排 include 之后调用）
# -----------------------------------------------------------------------------
# 为什么必须延迟：
#   生成器编排文件（cmake/scripts/verible-generators.cmake，由 flexbison-gen 提供）
#   在 configure 期间才**声明**生成规则，生成物要等到 build 期才出现。
#   如果在本文件前半段就判断 EXISTS，那时文件还不存在 → 挂接被静默跳过 →
#   库建出来但没有那个 .cc → 链接期 LNK2001/LNK1120。
#   所以这里定义函数，在文件末尾 include 完生成器编配后再调用一次。
#
# 注意：函数里仍然用 EXISTS 判断。首次 configure（生成器刚就位、文件还没生成）
# 时仍会跳过；此时会打印提示，**再 configure 一次**（或直接 build，生成物出来后
# CMake 会自动重跑 configure）就能挂上。
function(verible_mount_generated_sources)
    set(_search_dirs ${ARGN})
    set(_changed FALSE)
    foreach(_t IN LISTS _verible_all_targets)
        if(NOT TARGET ${_t})
            continue()
        endif()
        get_target_property(_ttype ${_t} TYPE)
        get_target_property(_gs ${_t} verible_generated_sources)
        if(_gs AND NOT _ttype STREQUAL "INTERFACE_LIBRARY")
            get_target_property(_mounted ${_t} verible_mounted_sources)
            set(_resolved "")
            foreach(_f IN LISTS _gs)
                set(_found "")
                foreach(_dir IN LISTS _search_dirs)
                    if(NOT _found AND EXISTS "${_dir}/${_f}")
                        set(_found "${_dir}/${_f}")
                    endif()
                endforeach()
                if(_found)
                    list(APPEND _resolved "${_found}")
                endif()
            endforeach()
            if(_resolved)
                target_sources(${_t} PRIVATE ${_resolved})
                set_property(TARGET ${_t} PROPERTY verible_mounted_sources ${_resolved})
                set(_changed TRUE)
            elseif(NOT _mounted)
                message(STATUS
                    "Verible: ${_t} 还缺生成源文件（${_gs}）——生成规则尚未产出的情况下属正常，"
                    "生成后重跑 configure 即自动挂接")
            endif()
        endif()
        get_target_property(_gh ${_t} verible_generated_headers)
        if(_gh)
            foreach(_h IN LISTS _gh)
                set(_found "")
                foreach(_dir IN LISTS _search_dirs)
                    if(NOT _found AND EXISTS "${_dir}/${_h}")
                        set(_found "${_dir}/${_h}")
                    endif()
                endforeach()
                if(_found)
                    if(_ttype STREQUAL "INTERFACE_LIBRARY")
                        target_sources(${_t} INTERFACE "${_found}")
                    else()
                        target_sources(${_t} PRIVATE "${_found}")
                    endif()
                endif()
            endforeach()
        endif()
    endforeach()
    set(VERIBLE_MOUNT_CHANGED ${_changed} PARENT_SCOPE)
endfunction()


# -----------------------------------------------------------------------------
# 生成文件：verilog_nonterminals_foreach-gen.inc（原 BUILD 的 genrule）
# -----------------------------------------------------------------------------
# BUILD:
#   genrule(name = "verilog-nonterminals-foreach-gen", srcs = ["verilog-nonterminals.h"],
#           outs = ["verilog_nonterminals_foreach-gen.inc"],
#           cmd  = "sed -n '/BEGIN GENERATE/,/END GENERATE/p' | grep -v GENERATE | sed ...")
# Bazel 用 sed/grep，Windows 上没有；改用 cmake -P 脚本
# （cmake/scripts/verible-nonterminals.cmake，由 verible-build 提供）。
set(_verible_nonterminals_inc
    "${_verible_gen_cst_dir}/verilog_nonterminals_foreach-gen.inc")
set(_verible_nonterminals_script
    "${FPGA_LSP_ROOT}/cmake/scripts/verible-nonterminals.cmake")
if(EXISTS "${_verible_nonterminals_script}" AND TARGET verible__verilog__CST__verilog-nonterminals)
    add_custom_command(
        OUTPUT "${_verible_nonterminals_inc}"
        COMMAND "${CMAKE_COMMAND}"
                "-DIN=${FPGA_LSP_VERIBLE_DIR}/verible/verilog/CST/verilog-nonterminals.h"
                "-DOUT=${_verible_nonterminals_inc}"
                -P "${_verible_nonterminals_script}"
        DEPENDS "${FPGA_LSP_VERIBLE_DIR}/verible/verilog/CST/verilog-nonterminals.h"
                "${_verible_nonterminals_script}"
        COMMENT "Verible: 生成 verilog_nonterminals_foreach-gen.inc"
        VERBATIM)
    # 让生成的 .inc 进入 verilog-nonterminals 的编译命令行（作为 src，Bazel 同语义）
    foreach(_t verible__verilog__CST__verilog-nonterminals
              verible__verilog__CST__verilog-matchers)
        if(TARGET ${_t})
            target_sources(${_t} PRIVATE "${_verible_nonterminals_inc}")
            target_include_directories(${_t} PRIVATE
                "${_verible_gen_include_dir}")
            set_source_files_properties("${_verible_nonterminals_inc}"
                PROPERTIES HEADER_FILE_ONLY FALSE)
        endif()
    endforeach()

    # ⚠ 关键：仅仅把它放进 target_sources 是**不够**的。
    # .inc 是被 verilog-nonterminals.h 用 #include 引用的（不是直接编译的源），
    # CMake/Ninja 不会因此建立依赖 → add_custom_command 的 OUTPUT 没人消费，
    # 生成步骤根本不会执行，编译时 C1083。
    # 所以必须用一个显式的 custom target 把生成挂进依赖图，并让消费方依赖它。
    if(NOT TARGET verible_generate_nonterminals)
        add_custom_target(verible_generate_nonterminals
            DEPENDS "${_verible_nonterminals_inc}")
    endif()
    # 也纳入 verible_generated 汇总目标，这样 `--target verible_generated`
    # 一次就能产出全部生成物（含 .inc），两阶段 configure 只需一轮。
    if(TARGET verible_generated)
        add_dependencies(verible_generated verible_generate_nonterminals)
    endif()
    foreach(_t verible__verilog__CST__verilog-nonterminals
              verible__verilog__CST__verilog-matchers)
        if(TARGET ${_t})
            add_dependencies(${_t} verible_generate_nonterminals)
        endif()
    endforeach()
else()
    message(WARNING
        "Verible: 缺少 cmake/scripts/verible-nonterminals.cmake，"
        "verilog-nonterminals 将无法编译（任务 0-B 的生成器需要它）")
endif()

# -----------------------------------------------------------------------------
# 生成文件：generated-verible-build-version.h（原 BUILD 的 version-header genrule）
# -----------------------------------------------------------------------------
# Bazel 用 workspace status 生成；这里从 VENDOR-INFO.md 抽 commit，写一个最小头文件。
# 目标：verible__common__util__build-version（INTERFACE，供 init-command-line 用）
set(_verible_build_version_dir "${CMAKE_BINARY_DIR}/verible/gen")
set(_verible_build_version_h
    "${_verible_build_version_dir}/generated-verible-build-version.h")
if(NOT EXISTS "${_verible_build_version_h}")
    set(_verible_commit "unknown")
    if(EXISTS "${FPGA_LSP_VERIBLE_DIR}/VENDOR-INFO.md")
        file(STRINGS "${FPGA_LSP_VERIBLE_DIR}/VENDOR-INFO.md" _vi_lines
             REGEX "[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]")
        foreach(_line IN LISTS _vi_lines)
            if(_line MATCHES "([0-9a-f]{7,40})")
                set(_verible_commit "${CMAKE_MATCH_1}")
                break()
            endif()
        endforeach()
    endif()
    file(WRITE "${_verible_build_version_h}"
"// GENERATED by cmake/Verible.cmake — Bazel 的 version-header genrule 的 CMake 等价物
// Verible vendored commit: ${_verible_commit}
#define VERIBLE_GIT_COMMIT \"${_verible_commit}\"
#define VERIBLE_MODULE_VERSION \"${_verible_commit}\"
")
endif()

# 生成的头文件同时挂到 build-version 目标上（供 IDE / 依赖追踪）。
# 注意：这是无条件执行的——生成本身不依赖 target 是否已存在，
# 而 target_sources 只在 target 存在时才调用（避免 INTERFACE 误用）。
if(TARGET verible__common__util__build-version)
    target_sources(verible__common__util__build-version INTERFACE
        "${_verible_build_version_h}")
endif()
# 注意：BUILD 里写的是 hdrs = ["generated-verible-build-version.h"]，
# init-command-line.cc 里也按 "verible/common/util/generated-verible-build-version.h"
# 引用它 —— 这个 include 前缀无法用 -I 拼接出来（会变成
# <gen>/verible/common/util/...），所以这里补一层构建目录结构 + 转发头。
set(_verible_gen_util_dir
    "${_verible_gen_include_dir}/verible/common/util")
if(NOT EXISTS "${_verible_gen_util_dir}/generated-verible-build-version.h")
    file(MAKE_DIRECTORY "${_verible_gen_util_dir}")
    file(WRITE "${_verible_gen_util_dir}/generated-verible-build-version.h"
"// GENERATED by cmake/Verible.cmake —— 转发头。
// 用绝对路径 include，避免与 <gen> 下的同名文件互相包含。
#ifndef VERIBLE_GENERATED_BUILD_VERSION_FORWARD_H_
#define VERIBLE_GENERATED_BUILD_VERSION_FORWARD_H_
#include \"${_verible_build_version_h}\"
#endif  // VERIBLE_GENERATED_BUILD_VERSION_FORWARD_H_
")
endif()

# =============================================================================
# 聚合 target
# =============================================================================
# -----------------------------------------------------------------------------
# verible_lint_rules_all：全部 lint 规则库 + /WHOLEARCHIVE
# -----------------------------------------------------------------------------
# 为什么必须 /WHOLEARCHIVE：
#   每条规则靠 VERILOG_REGISTER_LINT_RULE 宏产生一个 **static 全局对象**在启动时
#   自注册（见 verible/verilog/analysis/lint-rule-registry.h）。这些注册对象
#   没有任何外部符号引用，纯粹靠静态初始化生效。
#   MSVC 静态库链接器默认「只取被引用到的 .obj」，于是注册对象被整体丢弃 ——
#   结果是程序正常启动、不报错、退出码 0，但规则少了或全没了。
#   这是本项目已经踩过两次的同类问题（verilog-y-cc 的 INTERFACE、
#   command-file-lexer 不在依赖图），所以统一在这里封装，下游不要自己列。
#
# 下游用法：
#   target_link_libraries(x PRIVATE verible_lint_rules_all)
# 就自动带上全部规则库与 /WHOLEARCHIVE，不会再漏。
if(NOT TARGET verible_lint_rules_all)
    add_library(verible_lint_rules_all INTERFACE)
    target_link_libraries(verible_lint_rules_all INTERFACE verible_common_opts)

    # 优先用 BUILD 里的聚合 target verilog-lint-rules（deps 列了全部 58 个规则库）
    if(TARGET verible__verilog__analysis__checkers__verilog-lint-rules)
        # 逐个规则库：既 link（建立构建依赖），又加 /WHOLEARCHIVE
        get_target_property(_lint_rule_deps
            verible__verilog__analysis__checkers__verilog-lint-rules
            INTERFACE_LINK_LIBRARIES)
        set(_whole_archive_libs "")
        if(_lint_rule_deps)
            foreach(_d IN LISTS _lint_rule_deps)
                # 只处理本工程的规则库（跳过 absl:: 等）
                if(TARGET ${_d})
                    get_target_property(_dtype ${_d} TYPE)
                    if(_dtype STREQUAL "STATIC_LIBRARY")
                        list(APPEND _whole_archive_libs ${_d})
                    endif()
                endif()
            endforeach()
        endif()
        list(REMOVE_DUPLICATES _whole_archive_libs)
        if(MSVC)
            foreach(_lib IN LISTS _whole_archive_libs)
                target_link_libraries(verible_lint_rules_all INTERFACE "${_lib}")
                target_link_options(verible_lint_rules_all INTERFACE
                    "/WHOLEARCHIVE:$<TARGET_FILE:${_lib}>")
            endforeach()
        else()
            target_link_libraries(verible_lint_rules_all INTERFACE ${_whole_archive_libs})
        endif()
        message(STATUS "Verible: verible_lint_rules_all 聚合了 ${_whole_archive_libs} 个规则库（不含聚合库本身）")
    else()
        message(WARNING
            "Verible: 没有 verilog-lint-rules target，lint 规则不会进入构建。"
            "请确认 thirdparty/verible/verible/verilog/analysis/checkers/CMakeLists.txt 已生成。")
    endif()

    # 规则运行期还需要 registry / descriptions / 分析器本体
    foreach(_rt
            verible__verilog__analysis__lint-rule-registry
            verible__verilog__analysis__descriptions
            verible__verilog__analysis__verilog-analyzer
            verible__verilog__analysis__verilog-linter)
        if(TARGET ${_rt})
            target_link_libraries(verible_lint_rules_all INTERFACE ${_rt})
        endif()
    endforeach()
endif()

# -----------------------------------------------------------------------------
# verible_parser_libs：解析链路（lexer + parser + CST + 其传递依赖）
# -----------------------------------------------------------------------------
# alwayslink 的等价物：BUILD 里 verilog-y-cc 标了 alwayslink = 1。
# MSVC 静态库没有对应属性，Bazel 的 alwayslink 语义是「即使没被引用也要把整个
# 归档链进来」，对应链接器选项 /WHOLEARCHIVE。
#
# 为什么要它：verilog-parser.cc 调用 bison 生成的 verilog_parse()，而
# verilog_debug / verilog_symbol_name 等是 .tab.cc 里的全局构造/表格。
# 链接器若认为某个归档成员没被引用就会丢掉，出现
#   LNK2001: 无法解析的外部符号 verilog::verilog_parse / verilog_debug
#
# ⚠ /WHOLEARCHIVE:<file> 要求该 .lib **已经存在**，否则 LNK1356。
# 所以这些库必须同时出现在 INTERFACE 链接列表里（建立构建依赖），
# 只加 link option 是不够的。
set(_VERIBLE_WHOLEARCHIVE_TARGETS
    verible__verilog__parser__verilog-y-cc
    verible__verilog__parser__verilog-lexer
    verible__common__analysis__command-file-lexer
)

# 下游 cst_dump 直接 target_link_libraries(cst_dump PRIVATE verible_parser_libs)
if(NOT TARGET verible_parser_libs)
    add_library(verible_parser_libs INTERFACE)
    target_link_libraries(verible_parser_libs INTERFACE
        verible_common_opts
        verible::verilog::parser::verilog-parser
        verible::verilog::parser::verilog-lexer
        verible::verilog::parser::verilog-lexical-context
        verible::verilog::parser::verilog-token
        verible::verilog::parser::verilog-token-classifications
        verible::verilog::parser::verilog-token-enum
        verible::verilog::CST::verilog-nonterminals
        verible::verilog::CST::verilog-treebuilder-utils
        verible::verilog::CST::verilog-tree-print
        verible::verilog::CST::verilog-tree-json
        verible::verilog::analysis::verilog-analyzer
        verible::verilog::preprocessor::verilog-preprocess
        verible::common::analysis::file-analyzer
    )
    # alwayslink 等价物：把这些归档整个链进来（仅 MSVC）
    # 同时显式 link 一次，建立构建依赖，保证 .lib 在链接前已生成（否则 LNK1356）。
    if(MSVC)
        foreach(_wa IN LISTS _VERIBLE_WHOLEARCHIVE_TARGETS)
            if(TARGET ${_wa})
                target_link_libraries(verible_parser_libs INTERFACE "${_wa}")
                target_link_options(verible_parser_libs INTERFACE
                    "/WHOLEARCHIVE:$<TARGET_FILE:${_wa}>")
            endif()
        endforeach()
    endif()
endif()

# verible_all_libs：阶段 0 纳入的所有 verible 库（给需要全量符号的下游用）
if(NOT TARGET verible_all_libs)
    add_library(verible_all_libs INTERFACE)
    target_link_libraries(verible_all_libs INTERFACE
        verible_parser_libs
        verible::verilog::CST::DPI
        verible::verilog::CST::declaration
        verible::verilog::CST::expression
        verible::verilog::CST::functions
        verible::verilog::CST::identifier
        verible::verilog::CST::module
        verible::verilog::CST::port
        verible::verilog::CST::type
        verible::verilog::CST::verilog-matchers
    )
endif()

# 对外 facade：从「空 INTERFACE」升级为聚合真实静态库
target_link_libraries(fpga_lsp_verible INTERFACE verible_parser_libs)

# =============================================================================
# verible_formatter_libs：formatter 链路（阶段 1 formatter 门禁用）
# =============================================================================
# 下游用法：
#   target_link_libraries(format_dump PRIVATE verible_formatter_libs)
#
# 为什么单独聚合而不并进 verible_parser_libs：
#   * formatter 的编译代价不小（tree-unwrapper.cc 137 KB、align.cc 70 KB，
#     都需要 /bigobj），没有必要让只做解析的下游（cst_dump）承担。
#   * 语义上也清楚：解析链路 vs 格式化链路 是两个用途。
if(FPGA_LSP_VERIBLE_ENABLED AND NOT TARGET verible_formatter_libs)
    add_library(verible_formatter_libs INTERFACE)
    # 入口：FormatVerilog() 在 formatter 里；InitializeFromFlags() 在 *-format-style-init 里。
    # 其余（align / tree-unwrapper / token-annotator / layout-optimizer 等）
    # 由 formatter 与 *-format-style-init 的 PUBLIC 依赖自动传递，
    # 这里显式列出关键几个，避免上游 BUILD 的依赖声明不全时链接失败。
    target_link_libraries(verible_formatter_libs INTERFACE
        verible_parser_libs
        verible::verilog::formatting::formatter
        verible::verilog::formatting::format-style
        verible::verilog::formatting::format-style-init
        verible::verilog::formatting::align
        verible::verilog::formatting::tree-unwrapper
        verible::verilog::formatting::token-annotator
        verible::verilog::formatting::comment-controls
        verible::common::formatting::basic-format-style
        verible::common::formatting::basic-format-style-init
        verible::common::formatting::align
        verible::common::formatting::tree-unwrapper
        verible::common::formatting::tree-annotator
        verible::common::formatting::layout-optimizer
        verible::common::formatting::line-wrap-searcher
        verible::common::formatting::unwrapped-line
        verible::common::formatting::state-node
        verible::common::formatting::token-partition-tree
        verible::common::formatting::verification
        verible::common::formatting::format-token
    )
endif()

# =============================================================================
# common/lsp 的两阶段自举：jcxxgen -> lsp-protocol.h
# =============================================================================
# BUILD:
#   cc_binary(name = "jcxxgen", srcs = ["jcxxgen.cc"], ...)
#   genrule(name = "lsp-protocol-gen", srcs = ["lsp-protocol.yaml"],
#           outs = ["lsp-protocol.h"], tools = [":jcxxgen"],
#           cmd = "$(location :jcxxgen) --class_namespace verible::lsp --output $@ $<")
#
# CMake 里的自举坑（本块存在的原因）：
#   * configure 期 jcxxgen.exe 还不存在，不能把它当普通源文件
#   * 但 add_custom_command 可以把「某个 target 的可执行文件」写成 COMMAND，
#     CMake 会自动建立构建依赖（先编 jcxxgen，再跑它）——这是正确用法
#   * 生成的头必须放在 <gen>/verible/common/lsp/ 下，
#     因为源码里写的是 #include "verible/common/lsp/lsp-protocol.h"
if(TARGET verible__common__lsp__jcxxgen
   AND EXISTS "${FPGA_LSP_VERIBLE_DIR}/verible/common/lsp/lsp-protocol.yaml")
    set(_verible_gen_lsp_dir "${_verible_gen_include_dir}/verible/common/lsp")
    file(MAKE_DIRECTORY "${_verible_gen_lsp_dir}")
    set(_verible_lsp_protocol_h "${_verible_gen_lsp_dir}/lsp-protocol.h")
    set(_verible_lsp_yaml
        "${FPGA_LSP_VERIBLE_DIR}/verible/common/lsp/lsp-protocol.yaml")

    add_custom_command(
        OUTPUT "${_verible_lsp_protocol_h}"
        COMMAND verible__common__lsp__jcxxgen
                --class_namespace verible::lsp
                --output "${_verible_lsp_protocol_h}"
                "${_verible_lsp_yaml}"
        DEPENDS verible__common__lsp__jcxxgen "${_verible_lsp_yaml}"
        COMMENT "Verible: jcxxgen 生成 lsp-protocol.h"
        VERBATIM)

    # 挂到 lsp-protocol(INTERFACE) 上，并让所有依赖它的库等这个文件生成完
    if(TARGET verible__common__lsp__lsp-protocol)
        target_sources(verible__common__lsp__lsp-protocol INTERFACE
            "${_verible_lsp_protocol_h}")
    endif()
    # custom target 便于单独构建 / 供 add_dependencies
    if(NOT TARGET verible_generate_lsp_protocol)
        add_custom_target(verible_generate_lsp_protocol
            DEPENDS "${_verible_lsp_protocol_h}")
        add_dependencies(verible_generate_lsp_protocol verible__common__lsp__jcxxgen)
    endif()

    # 凡是用到 lsp-protocol 的库，都加一条 order-only 依赖，
    # 保证「先生成头，再编译」——否则并行构建会偶发 C1083。
    foreach(_lt
            verible__common__lsp__json-rpc-dispatcher
            verible__common__lsp__lsp-protocol-operators
            verible__common__lsp__lsp-text-buffer
            verible__common__lsp__lsp-file-utils
            verible__common__lsp__message-stream-splitter
            verible__common__lsp__json-rpc-expect)
        if(TARGET ${_lt})
            add_dependencies(${_lt} verible_generate_lsp_protocol)
        endif()
    endforeach()
else()
    message(STATUS
        "Verible: 跳过 jcxxgen 自举（common/lsp 未纳入或 lsp-protocol.yaml 缺失）")
endif()

# =============================================================================
# flex/bison 代码生成（任务 0-D 提供，自动接入）
# =============================================================================
# 0-D 的脚本负责 G1–G6：verilog.yy.cc / verilog.tab.hh+cc / verilog-token-enum.h /
# verilog-parse-interface.h / verilog-final.tab.cc / command-file.yy.cc。
# 这里只是 include 点：脚本存在就接上，不存在就给出清晰提示（不 FATAL，便于
# 0-B/0-D 并行开发时先跑通非 parser 部分）。
set(VERIBLE_GENERATORS_CMAKE
    "${FPGA_LSP_ROOT}/cmake/scripts/verible-generators.cmake")
if(EXISTS "${VERIBLE_GENERATORS_CMAKE}")
    include("${VERIBLE_GENERATORS_CMAKE}")

    # -------------------------------------------------------------------------
    # 让「所有用到生成头的库」都等生成完成（order-only 依赖）
    # -------------------------------------------------------------------------
    # verible-generators.cmake 里的 add_dependencies 只覆盖了直接消费生成
    # **源文件**的三个库（verilog-y-cc / verilog-lexer / command-file-lexer）。
    # 但生成**头文件**会被大量下游库 include：
    #   verilog-token-enum.h   <- CST 全套、verilog/analysis、checkers...
    #   verilog-parse-interface.h / verilog.tab.hh
    #   verilog_nonterminals_foreach-gen.inc
    # Ninja 无法从 include 路径推断依赖（我们用的是 -I 目录，不是 add_custom_command
    # 的 OUTPUT 显式引用），因此这些库会和生成步骤**并行**启动，
    # 偶发 C1083: 无法打开包括文件 "verible/verilog/parser/verilog-token-enum.h"。
    #
    # 修法：把所有 verible_* 库都 add_dependencies 到 verible_generated。
    # 代价是所有库都要等代码生成完成才开始编译（生成只要 ~10s，可接受），
    # 换来的是**确定性**——不会出现「这次能编下次不能编」的幻觉错误。
    if(TARGET verible_generated)
        foreach(_dir IN LISTS _VERIBLE_PACKAGES)
            get_property(_tgts DIRECTORY "${FPGA_LSP_VERIBLE_DIR}/${_dir}"
                         PROPERTY BUILDSYSTEM_TARGETS)
            foreach(_t IN LISTS _tgts)
                if(TARGET ${_t})
                    get_target_property(_tt ${_t} TYPE)
                    if(NOT _tt STREQUAL "INTERFACE_LIBRARY")
                        add_dependencies(${_t} verible_generated)
                    endif()
                endif()
            endforeach()
        endforeach()
        message(STATUS "Verible: 已让全部 verible_* 目标等待 verible_generated（避免生成物竞态 C1083）")
    endif()
else()
    message(WARNING
        "Verible: 未找到 ${VERIBLE_GENERATORS_CMAKE}（任务 0-D 尚未交付）。\n"
        "         verilog/parser 包依赖它生成的 verilog-final.tab.cc 等文件，"
        "在此之前 parser 相关 target 无法编译。")
endif()

# -----------------------------------------------------------------------------
# 挂接构建期生成物（必须在上面 include 完生成器编排之后调用）
# -----------------------------------------------------------------------------
# 此时生成规则已经声明。若生成物在磁盘上已存在（正常情况下：生成器已跑过一轮，
# 或者 CMake 因为找不到文件而重跑 configure），这里就把它们作为源文件挂上。
# 否则打提示，等生成后下次 configure 自动补上。
verible_mount_generated_sources(${_VERIBLE_GEN_SEARCH_DIRS})
if(VERIBLE_MOUNT_CHANGED)
    message(STATUS "Verible: 已挂接构建期生成物到对应 target")
endif()

# -----------------------------------------------------------------------------
# 阶段 1 待办
# -----------------------------------------------------------------------------
# TODO(阶段 1)：把 common/{formatting,lsp,tools}、verilog/{formatting,transform,
#   tools/*,analysis/checkers} 也加入 add_subdirectory，并运行
#   `python tools/gen_verible_cmake.py` 重新生成对应 CMakeLists.txt。
# TODO(阶段 1)：清点 alwayslink=1 的库（verilog-y-cc / parse），在最终可执行文件上
#   用 /WHOLEARCHIVE: 包起来，否则 bison 的全局构造可能被 MSVC 链接器丢弃。
