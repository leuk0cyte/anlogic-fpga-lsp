                    "group": "navigation@1"
                },
                {
                    "command": "fpgaLsp.probeCapture",
                    "when": "view == fpgaLsp.probeView",
                    "group": "navigation@2"
                },
                {
                    "command": "fpgaLsp.showActions",
                    "when": "view == fpgaLsp.probeView",
                    "group": "navigation@3"
                }
            ],
            "view/item/context": [
                {
                    "command": "fpgaLsp.goToDefinition",
                    "when": "view == fpgaLsp.modulesView && viewItem =~ /^fpgaModule(Defined|Root)$/",
                    "group": "navigation@1"
                },
                {
                    "command": "fpgaLsp.goToInstantiation",
                    "when": "view == fpgaLsp.modulesView && viewItem =~ /^fpgaModule(Defined|Blackbox)$/",
                    "group": "navigation@2"
                },
                {
                    "command": "fpgaLsp.copyModulePath",
                    "when": "view == fpgaLsp.modulesView && viewItem =~ /^fpgaModule/",
                    "group": "navigation@3"
                },
                {
                    "command": "fpgaLsp.openArtifact",
                    "when": "view == fpgaLsp.flowView && viewItem == fpgaArtifact",
                    "group": "navigation@1"
                },
                {
                    "command": "fpgaLsp.openReportFile",
                    "when": "view == fpgaLsp.flowView && viewItem == fpgaReportFile",
                    "group": "navigation@1"
                },
                {
                    "command": "fpgaLsp.showReports",
                    "when": "view == fpgaLsp.flowView && viewItem == fpgaAction",
                    "group": "navigation@1"
                },
                {
                    "command": "fpgaLsp.renameProject",
                    "when": "view == fpgaLsp.flowView && viewItem == fpgaProject",
                    "group": "inline@1"
                },
                {
                    "command": "fpgaLsp.updateProject",
                    "when": "view == fpgaLsp.flowView && viewItem == fpgaProject",
                    "group": "inline@2"
                },
                {
                    "command": "fpgaLsp.selectProject",
                    "when": "view == fpgaLsp.flowView && viewItem =~ /^fpgaProject(File)?$/",
                    "group": "inline@0"
                },
                {
                    "command": "fpgaLsp.probeToggleSignal",
                    "when": "view == fpgaLsp.probeView && viewItem == fpgaProbeSignal",
                    "group": "inline@1"
                },
                {
                    "command": "fpgaLsp.flowStepRun",
                    "when": "view == fpgaLsp.flowView && viewItem == fpgaFlowStep",
                    "group": "flowstep@1"
                },
                {
                    "command": "fpgaLsp.flowStepReset",
                    "when": "view == fpgaLsp.flowView && viewItem == fpgaFlowStep",
                    "group": "flowstep@2"
                }
            ],
            "commandPalette": [
                {
                    "command": "fpgaLsp.openModuleNode",
                    "when": "false"
                },
                {
                    "command": "fpgaLsp.goToDefinition",
                    "when": "false"
                },
                {
                    "command": "fpgaLsp.goToInstantiation",
                    "when": "false"
                },
                {
                    "command": "fpgaLsp.copyModulePath",
                    "when": "false"
                },
                {
                    "command": "fpgaLsp.openArtifact",
                    "when": "false"
                },
                {
                    "command": "fpgaLsp.openReportFile",
                    "when": "false"
                },
                {
                    "command": "fpgaLsp.probeToggleSignal",
                    "when": "false"
                },
                {
                    "command": "fpgaLsp.probeAddSignals",
                    "when": "false"
                }
            ],
            "editor/title": [
                {
                    "command": "fpgaLsp.readDesign",
                    "when": "resourceExtname =~ /\\.(v|vh|sv|svh)$/",
                    "group": "navigation@9"
                }
            ],
            "editor/context": [
                {
                    "command": "fpgaLsp.copySymbolPath",
                    "when": "resourceLangId =~ /verilog|systemverilog/",
                    "group": "navigation@8"
                }
            ]
        },
        "grammars": [
            {
                "language": "verilog",
                "scopeName": "source.verilog",
                "path": "./syntaxes/verilog.tmLanguage.json"
