{
    "name": "fpga-lsp-anlogic",
    "displayName": "Anlogic FPGA LSP (TangDynasty)",
    "description": "Language support and IDE views for Anlogic TD FPGA projects: ADC pin constraints, SDC, project .al, Verilog index, TD-backed diagnostics, module hierarchy, syn/phy flow control and QoR/timing/area reports.",
    "version": "0.21.3",
    "publisher": "fpga-lsp",
    "license": "AGPL-3.0-or-later",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Programming Languages",
        "Linters",
        "Visualization"
    ],
    "activationEvents": [
        "onView:fpgaLsp.modulesView",
        "onView:fpgaLsp.flowView",
        "onView:fpgaLsp.probeView",
        "onLanguage:verilog",
        "onLanguage:systemverilog",
        "onLanguage:vhdl",
        "onLanguage:adc",
        "onLanguage:sdc",
        "onLanguage:al-project",
        "workspaceContains:**/*.al"
    ],
    "main": "./extension.js",
    "scripts": {
        "test": "node test/run.js",
        "test:integration": "node test/integration-server.js",
        "test:locate": "node test/locate-server.test.js",
        "bundle:server": "node scripts/bundle-server.js",
        "package": "node scripts/bundle-server.js && npx --yes @vscode/vsce@4 package --allow-missing-repository",
        "test:vscode": "powershell -ExecutionPolicy Bypass -File scripts/run-vscode-test.ps1",
        "test:verible": "node test/verible.test.js"
    },
    "contributes": {
        "languages": [
            {
                "id": "adc",
                "aliases": [
                    "ADC",
                    "Anlogic ADC"
                ],
                "extensions": [
                    ".adc"
                ]
            },
            {
                "id": "sdc",
                "aliases": [
                    "SDC",
                    "Timing Constraints"
                ],
                "extensions": [
                    ".sdc"
                ]
            },
            {
                "id": "al-project",
                "aliases": [
                    "Anlogic Project"
                ],
                "extensions": [
                    ".al"
                ]
            },
            {
                "id": "verilog",
                "aliases": [
                    "Verilog",
                    "verilog"
                ],
                "extensions": [
                    ".v",
                    ".vh"
                ],
                "configuration": "./language-configuration/verilog.json"
            },
            {
                "id": "systemverilog",
                "aliases": [
                    "SystemVerilog",
                    "systemverilog"
                ],
                "extensions": [
                    ".sv",
                    ".svh"
                ],
                "configuration": "./language-configuration/verilog.json"
            },
            {
                "id": "vhdl",
                "aliases": [
                    "VHDL",
                    "vhdl"
                ],
                "extensions": [
                    ".vhd",
                    ".vhdl"
                ],
                "configuration": "./language-configuration/vhdl.json"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "fpgaLsp",
                    "title": "FPGA",
                    "icon": "resources/icon-activitybar.svg"
                }
            ]
        },
        "views": {
            "explorer": [
                {
                    "id": "fpgaLsp.modulesView",
                    "name": "Module Hierarchy"
                }
            ],
            "fpgaLsp": [
                {
                    "id": "fpgaLsp.flowView",
                    "name": "Project & Flow"
                },
                {
                    "id": "fpgaLsp.reportsView",
                    "name": "Reports"
                },
                {
                    "id": "fpgaLsp.probeView",
                    "name": "ChipWatcher"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "fpgaLsp.modulesView",
                "contents": "No Anlogic .al project found.\n[Open Folder](command:workbench.action.files.openFolder)\n[Refresh](command:fpgaLsp.refreshModules)"
            },
            {
                "view": "fpgaLsp.flowView",
                "contents": "No flow data yet.\n[Run Synthesis](command:fpgaLsp.runSyn)\n[Run Full Flow](command:fpgaLsp.runAll)"
            }
        ],
        "configuration": {
            "title": "Anlogic FPGA LSP",
            "properties": {
                "fpgaLsp.serverPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the native language server (fpgalsp-native.exe). Leave empty to auto-detect: serverRoot, the dev build directory, then the bundled server/bin inside the VSIX."
                },
                "fpgaLsp.tdPath": {
                    "type": "string",
                    "default": "",
                    "description": "TangDynasty installation root, e.g. C:/Anlogic/TD_Release_<version>. Empty = auto-detect."
                },
                "fpgaLsp.tdCheckOnSave": {
                    "type": "boolean",
                    "default": true,
                    "description": "Run the authoritative TD read_hdl/read_adc check on save (~1-2 s) and publish its diagnostics."
                },
                "fpgaLsp.projectFile": {
                    "type": "string",
                    "default": "",
                    "description": "Explicit .al project file. Empty = use the nearest enclosing project."
                },
                "fpgaLsp.flowJobs": {
                    "type": "number",
                    "default": 6,
                    "minimum": 1,
                    "maximum": 64,
                    "description": "Number of parallel jobs passed to launch_runs (TD -jobs). Default 6 matches the TD GUI default."
                },
                "fpgaLsp.logFile": {
                    "type": "string",
                    "default": "",
                    "description": "Language server log file. Empty = <workspace>/.fpgalsp/logs/server.log."
                },
                "fpgaLsp.verible.format": {
                    "type": "boolean",
                    "default": true,
                    "description": "Use verible-verilog-format for Format Document (through the language server)."
                },
                "fpgaLsp.verible.args": {
                    "type": "array",
                    "default": [
                        "--column_limit=160",
                        "--indentation_spaces=4",
                        "--wrap_spaces=4",
                        "--try_wrap_long_lines=true",
                        "--assignment_statement_alignment=align",
                        "--case_items_alignment=align",
                        "--distribution_items_alignment=align",
                        "--enum_assignment_statement_alignment=align",
                        "--module_net_variable_alignment=align",
                        "--class_member_variable_alignment=align",
                        "--struct_union_members_alignment=align",
                        "--parameter_declaration_alignment=align",
                        "--port_declarations_alignment=align",
                        "--formal_parameters_alignment=align",
                        "--named_parameter_alignment=align",
                        "--named_port_alignment=align",
                        "--port_declarations_right_align_packed_dimensions=true",
                        "--port_declarations_right_align_unpacked_dimensions=true",
                        "--formal_parameters_indentation=indent",
                        "--named_parameter_indentation=indent",
                        "--named_port_indentation=indent",
                        "--port_declarations_indentation=indent",
                        "--alignment_group_boundary=blank-lines-and-separator-comments"
                    ],
                    "description": "Style flags for the embedded Verible formatter, same syntax as before (--flag=value; \"--flag value\" is accepted too). These built-in defaults match src/verible_bridge/format_text.cpp::DefaultStyleFlags() one for one (a unit test guards the drift): VS Code sends this setting to the backend at start-up and it REPLACES the server's copy. An empty array (or a client that sends nothing) keeps the server default. The semantics are wholesale replacement: once a non-empty array is given, the server defaults step aside entirely and any flag you leave out falls back to Verible's own default (2-space indent, infer alignment)."
                },
                "fpgaLsp.serverRoot": {
                    "type": "string",
                    "default": "",
                    "description": "(Legacy) Directory of the language server. The native build does not need it: leave empty and use fpgaLsp.serverPath to point at the exe."
                },
                "fpgaLsp.verible.path": {
                    "type": "string",
                    "default": "",
                    "description": "(Legacy) Path to an external verible-verilog-format. Leave empty to use the embedded Verible."
                },
                "fpgaLsp.verible.lintArgs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "--rules=+line-length=length:160"
                    ],
                    "description": "Arguments for the embedded Verible lint. Supports --rules= / --ruleset= / --rules_config= / --rules_config_search / --waiver_files=. Same rule as the formatter: these built-in defaults match src/verible_bridge/lint_text.cpp::DefaultLintFlags() one for one, VS Code sends them to the backend and they REPLACE the server defaults; an empty array keeps the server defaults. The old Python backend expected a string here and only accepted an array, so that default never actually took effect; both forms are accepted now."
                },
                "fpgaLsp.verible.highlight": {
                    "type": "boolean",
                    "default": true,
                    "description": "(Legacy) Whether to publish Verible diagnostics. Turn it off to keep only TD / constraint diagnostics."
                },
                "fpgaLsp.verible.autofix": {
                    "type": "boolean",
                    "default": true,
                    "description": "Offer quick fixes computed by the embedded Verible linter (no external verible binary needed)."
                },
                "fpgaLsp.mcp.allowFlow": {
                    "type": "boolean",
                    "default": true,
                    "description": "Expose MCP flow/analysis/strategy tools to agents (starts TD flows)."
                },
                "fpgaLsp.mcp.allowWrite": {
                    "type": "boolean",
                    "default": false,
                    "description": "Expose MCP project write tools (update/add source/rename .al)."
                },
                "fpgaLsp.mcp.attachOnStart": {
                    "type": "boolean",
                    "default": true,
                    "description": "Phase 2 client-side attach switch: when false the extension skips MCP server attach/registration entirely (feature-detected; the real attach lands in B4)."
                },
                "fpgaLsp.mcp.dynamicProvider": {
                    "type": "boolean",
                    "default": false,
                    "description": "Register the extension's dynamic MCP server definition provider. Disabled by default because Copilot cannot associate dynamic servers with a workspace; use FPGA: Install MCP Configuration to write a workspace .vscode/mcp.json instead."
                }
            }
        },
