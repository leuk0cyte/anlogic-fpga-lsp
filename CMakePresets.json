{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-msvc-base",
      "displayName": "Windows / MSVC x64 (Ninja) - base",
      "description": "基础配置：Ninja + cl.exe（由 vcvars64.bat 提供环境），静态 CRT，C++23。不直接使用，请用 debug/release/relwithdebinfo。",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "ABSL_MSVC_STATIC_RUNTIME": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_SHARED_LIBS": "OFF",
        "BUILD_TESTING": "ON",
        "FPGA_LSP_VERIBLE_ENABLED": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows / MSVC Debug",
      "description": "调试构建：/MTd + /Od + 调试信息",
      "inherits": "windows-msvc-base",
      "binaryDir": "${sourceDir}/build-dev",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows / MSVC Release（全量 LTO）",
      "description": "发布构建：/MT + /O2 + 全量 LTO（自有代码与 Verible 都参与 /GL，链接期 /LTCG）。实测：体积 -1.9%、lint 规则层 CPU -11.9%、解析层基本不变、重链约 48 s。输出到 build/。",
      "inherits": "windows-msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "FPGA_LSP_VERIBLE_ALLOW_LTO": "ON"
      }
    },
    {
      "name": "windows-msvc-relwithdebinfo",
      "displayName": "Windows / MSVC RelWithDebInfo",
      "description": "带调试信息的发布构建：/MT + /O2 + PDB，**不开 LTO**（保留可调试性与快速迭代）",
      "inherits": "windows-msvc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "windows-msvc-dev",
      "displayName": "Windows / MSVC Release（无 LTO，日常迭代）",
      "description": "与 windows-msvc-release 同优化等级但**关闭 IPO**，输出到 build-dev/。实测（本机 2×EPYC 96C/192T）：改一处代码后的增量构建 32 s，而 LTO 版要 139 s —— 因为 LTO 版 83% 的时间花在 58 个测试可执行文件的 /LTCG 链接上，这部分**不随核数扩展**。日常改代码/跑测试用这个；发版与性能数字用 windows-msvc-release。",
      "inherits": "windows-msvc-base",
      "binaryDir": "${sourceDir}/build-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF",
        "FPGA_LSP_VERIBLE_ALLOW_LTO": "OFF"
      }
    },
    {
      "name": "windows-msvc-release-lto",
      "displayName": "Windows / MSVC Release + 全量 LTO（独立目录）",
      "description": "与 windows-msvc-release 相同的 LTO 配置，但输出到 build-lto/，用于与普通 build/ 做 A/B 对照（保留兼容）。",
      "inherits": "windows-msvc-release",
      "binaryDir": "${sourceDir}/build-lto",
      "cacheVariables": {
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "FPGA_LSP_VERIBLE_ALLOW_LTO": "ON"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows / MSVC x64 (Release, 默认)",
      "description": "等价于 windows-msvc-release 的别名 preset，方便直接用 `cmake --preset windows-msvc`。",
      "inherits": "windows-msvc-release"
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc-debug", "displayName": "Build: MSVC Debug", "configurePreset": "windows-msvc-debug", "configuration": "Debug" },
    { "name": "windows-msvc-release", "displayName": "Build: MSVC Release", "configurePreset": "windows-msvc-release", "configuration": "Release" },
    { "name": "windows-msvc-relwithdebinfo", "displayName": "Build: MSVC RelWithDebInfo", "configurePreset": "windows-msvc-relwithdebinfo", "configuration": "RelWithDebInfo" },
    { "name": "windows-msvc-release-lto", "displayName": "Build: MSVC Release + LTO", "configurePreset": "windows-msvc-release-lto", "configuration": "Release" },
    { "name": "windows-msvc-dev", "displayName": "Build: MSVC Release（无 LTO）", "configurePreset": "windows-msvc-dev", "configuration": "Release" },
    { "name": "windows-msvc", "displayName": "Build: MSVC Release (默认)", "configurePreset": "windows-msvc", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "windows-msvc-debug", "displayName": "Test: MSVC Debug", "configurePreset": "windows-msvc-debug", "configuration": "Debug", "output": { "outputOnFailure": true }, "execution": { "jobs": 8 }, "environment": { "TMP": "${sourceDir}/build/Testing/tmp", "TEMP": "${sourceDir}/build/Testing/tmp" } },
    { "name": "windows-msvc-release", "displayName": "Test: MSVC Release", "configurePreset": "windows-msvc-release", "configuration": "Release", "output": { "outputOnFailure": true }, "execution": { "jobs": 8 }, "environment": { "TMP": "${sourceDir}/build/Testing/tmp", "TEMP": "${sourceDir}/build/Testing/tmp" } },
    { "name": "windows-msvc-dev", "displayName": "Test: MSVC Release（无 LTO 构建）", "configurePreset": "windows-msvc-dev", "configuration": "Release", "output": { "outputOnFailure": true }, "execution": { "jobs": 8 }, "environment": { "TMP": "${sourceDir}/build-dev/Testing/tmp", "TEMP": "${sourceDir}/build-dev/Testing/tmp" } }
  ]
}
